# ═══════════════════════════════════════════════════════════════════════════════
# Multi-Agent Code Refactoring & Audit Crew — Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenAI (default)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Option B: Anthropic Claude 4 (recommended — use bare model ID, not the anthropic/ prefix)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# OPENAI_MODEL_NAME=claude-sonnet-4-6
#
# Claude 3.5 also works and supports prefill natively (no patch needed):
# OPENAI_MODEL_NAME=claude-3-5-sonnet-20241022
#
# NOTE: OPENAI_API_KEY drives ChromaDB embeddings (crew memory).
#       Omit it when using Anthropic-only to disable memory gracefully.
#       Set both keys to enable memory with Anthropic for LLM calls.

# ── LLM Tuning ────────────────────────────────────────────────────────────────
# Lower temperature = more deterministic, conservative refactoring decisions
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192

# ── CrewAI ────────────────────────────────────────────────────────────────────
# Opt out of anonymous usage telemetry sent to CrewAI
CREWAI_TELEMETRY_OPT_OUT=true

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=outputs
LOG_LEVEL=INFO

# ── Optional: Jira Integration ────────────────────────────────────────────────
# Used by the PR generator to include Jira ticket links in PR descriptions.
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_USER_EMAIL=your-email@company.com
# JIRA_API_TOKEN=your-jira-api-token-here
# JIRA_PROJECT_KEY=SEC

# ── Optional: GitHub Integration ──────────────────────────────────────────────
# Used to programmatically create PRs via the GitHub API.
# GITHUB_TOKEN=ghp_your-personal-access-token-here
# GITHUB_REPO_OWNER=your-org
# GITHUB_REPO_NAME=your-repo

# ── Optional: GitLab Integration ──────────────────────────────────────────────
# GITLAB_TOKEN=glpat-your-gitlab-access-token
# GITLAB_HOST=https://gitlab.com
# GITLAB_PROJECT_ID=12345678

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  Variables below are populated from the REFACTORED code output.
#     Add these to your actual deployment environment (K8s Secrets, Vault, etc.)
#     NEVER use the placeholder values below in a real environment.
# ─────────────────────────────────────────────────────────────────────────────

# Database credentials (replace hardcoded values from legacy code)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=userdb
DB_USER=app_user
DB_PASSWORD=REPLACE_WITH_VAULT_SECRET

# API keys (replace hardcoded values from legacy code)
EXTERNAL_API_SECRET_KEY=REPLACE_WITH_VAULT_SECRET

# Application secrets
APP_SECRET_KEY=REPLACE_WITH_SECRETS_MANAGER_VALUE
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH_FROM_SECRETS_MANAGER
